{
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "files.autoSave": "afterDelay",
  "telemetry.telemetryLevel": "off",
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": false,
  "vim.smartRelativeLine": true,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "s"
      ],
      "after": [
        "leader",
        "leader",
        "s"
      ]
    },
    {
      "before": [
        "n"
      ],
      "after": [
        "n",
        "z",
        "z",
        "z",
        "v"
      ]
    },
    {
      "before": [
        "N"
      ],
      "after": [
        "N",
        "z",
        "z",
        "z",
        "v"
      ]
    },
    {
      "before": [
        "<c-d>"
      ],
      "after": [
        "<c-d>",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "<c-u>"
      ],
      "after": [
        "<c-u>",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "<c-h>"
      ],
      "after": [
        "<c-w>",
        "h"
      ]
    },
    {
      "before": [
        "<c-j>"
      ],
      "after": [
        "<c-w>",
        "j"
      ]
    },
    {
      "before": [
        "<c-k>"
      ],
      "after": [
        "<c-w>",
        "k"
      ]
    },
    {
      "before": [
        "<c-l>"
      ],
      "after": [
        "<c-w>",
        "l"
      ]
    },
    {
      "before": [
        "-"
      ],
      "after": [
        "<c-w>",
        "-"
      ]
    },
    {
      "before": [
        "="
      ],
      "after": [
        "<c-w>",
        "+"
      ]
    },
    {
      "before": [
        "_"
      ],
      "after": [
        "<c-w>",
        "<"
      ]
    },
    {
      "before": [
        "+"
      ],
      "after": [
        "<c-w>",
        ">"
      ]
    },
    {
      "before": [
        "<leader>"
      ],
      "commands": [
        "whichkey.show"
      ]
    },
    {
      "before": [
        "<Tab>"
      ],
      "after": [
        "g",
        "t"
      ]
    },
    {
      "before": [
        "<s-Tab>"
      ],
      "after": [
        "g",
        "T"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>"
      ],
      "commands": [
        "whichkey.show"
      ]
    }
  ],
  "vim.leader": "<space>",
  "keyboard.dispatch": "keyCode",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-b>": false,
    "<C-c>": false,
    "<C-e>": false,
    "<C-f>": false,
    "<C-v>": false,
    "<C-x>": false
  },
  "whichkey.delay": 0,
  "whichkey.sortOrder": "custom",
  "whichkey.bindings": [
    {
      "key": " ",
      "name": "Previous editor",
      "type": "command",
      "command": "workbench.action.openPreviousRecentlyUsedEditorInGroup"
    },
    {
      "key": "?",
      "name": "Search keybindings",
      "type": "command",
      "command": "whichkey.searchBindings"
    },
    {
      "key": "a",
      "name": "Activate...",
      "type": "bindings",
      "bindings": [
        {
          "key": "c",
          "name": "Source Control",
          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "d",
          "name": "Debug",
          "type": "command",
          "command": "workbench.view.debug"
        },
        {
          "key": "g",
          "name": "Gradle",
          "type": "command",
          "command": "gradleDefaultProjectsView.focus"
        },
        {
          "key": "m",
          "name": "Maven",
          "type": "command",
          "command": "mavenProjects.focus"
        },
        {
          "key": "p",
          "name": "Explorer",
          "type": "command",
          "command": "workbench.view.explorer"
        },
        {
          "key": "s",
          "name": "Outline",
          "type": "command",
          "command": "outline.focus"
        },
        {
          "key": "t",
          "name": "Terminal",
          "type": "command",
          "command": "workbench.action.terminal.toggleTerminal"
        }
      ]
    },
    {
      "key": "c",
      "name": "Close...",
      "type": "bindings",
      "bindings": [
        {
          "key": "O",
          "name": "Close other tabs",
          "type": "command",
          "command": "workbench.action.closeOtherEditors"
        }
      ]
    },
    {
      "key": "h",
      "name": "Hide sidebar and panel",
      "type": "commands",
      "commands": [
        "workbench.action.closeSidebar",
        "workbench.action.closePanel"
      ]
    },
    {
      "key": "n",
      "name": "New...",
      "type": "bindings",
      "bindings": [
        {
          "key": "p",
          "name": "New project window",
          "type": "command",
          "command": "workbench.action.newWindow"
        }
      ]
    },
    {
      "key": "o",
      "name": "Open...",
      "type": "bindings",
      "bindings": [
        {
          "key": "e",
          "name": "Reveal active file in Explorer",
          "type": "command",
          "command": "workbench.files.action.showActiveFileInExplorer"
        },
        {
          "key": "f",
          "name": "Open file",
          "type": "command",
          "command": "workbench.action.quickOpen"
        },
        {
          "key": "i",
          "name": "Organize imports",
          "type": "command",
          "command": "editor.action.organizeImports"
        },
        {
          "key": "p",
          "name": "Open Explorer",
          "type": "commands",
          "commands": [
            "workbench.view.explorer",
            "workbench.files.action.focusFilesExplorer"
          ]
        },
        {
          "key": "P",
          "name": "Open project / folder",
          "type": "command",
          "command": "workbench.action.files.openFolder"
        },
        {
          "key": "r",
          "name": "Open recent",
          "type": "command",
          "command": "workbench.action.openRecent"
        },
        {
          "key": "t",
          "name": "Open new terminal",
          "type": "command",
          "command": "workbench.action.terminal.new"
        }
      ]
    },
    {
      "key": "p",
      "name": "Popup...",
      "type": "bindings",
      "bindings": [
        {
          "key": "m",
          "name": "Explorer action menu",
          "type": "command",
          "command": "takeedev.explorerVimMenu.show"
        }
      ]
    },
    {
      "key": "q",
      "name": "Close current tab",
      "type": "command",
      "command": "workbench.action.closeActiveEditor"
    },
    {
      "key": "r",
      "name": "Run / Refactor...",
      "type": "bindings",
      "bindings": [
        {
          "key": "e",
          "name": "Refactor",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "r",
          "name": "Run Java file",
          "type": "command",
          "command": "java.debug.runJavaFile"
        }
      ]
    },
    {
      "key": "s",
      "name": "Show...",
      "type": "bindings",
      "bindings": [
        {
          "key": "m",
          "name": "Explorer action menu",
          "type": "command",
          "command": "takeedev.explorerVimMenu.show"
        },
        {
          "key": "P",
          "name": "Explorer action menu",
          "type": "command",
          "command": "takeedev.explorerVimMenu.show"
        }
      ]
    }
  ],
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "workbench.colorTheme": "Kimbie Dark",
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "java.compile.nullAnalysis.nonnull": [],
  "java.compile.nullAnalysis.nullable": [],
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.minimap.autohide": true,
  "editor.fontSize": 12,
  "dbcode.connections": [
    {
      "connectionId": "jU9eYucTEGShPXG9ZCDTk",
      "name": "Localhost",
      "driver": "mssql",
      "host": "localhost",
      "port": 1444,
      "ssl": false,
      "driverOptions": {
        "authType": "sql"
      },
      "username": "sa",
      "password": "",
      "savePassword": "secretStorage",
      "database": "AddressDB",
      "connectionTimeout": 30,
      "connectionType": "host",
      "group": "SQL Server"
    }
  ],
  "dbcode.history.enabled": true,
  "dbcode.tunnels": [],
  "workbench.activityBar.location": "top",
  "terminal.integrated.env.windows": {
  },
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorWidth": 4,
  "workbench.panel.showLabels": false,
  "terminal.integrated.fontFamily": "monospace",
  "git.autofetch": true,
  "workbench.iconTheme": "material-icon-theme"
}
